# ── LLM API ──────────────────────────────────────────────────────────────────
# MiniMax（国内平台 platform.minimax.cn，端点必须用 api.minimax.chat）
OPENAI_API_KEY=sk-api-xxxxxxxx
OPENAI_BASE_URL=https://api.minimax.chat/v1
MODEL_INTENT=abab6.5s-chat
MODEL_PLANNER=abab6.5s-chat
MODEL_GENERATOR=abab6.5s-chat

# OpenAI（直接使用 OpenAI 时去掉 OPENAI_BASE_URL 或设为空）
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=
# MODEL_INTENT=gpt-4o-mini
# MODEL_PLANNER=gpt-4o-mini
# MODEL_GENERATOR=gpt-4o-mini

# DeepSeek（国内直连，OpenAI 兼容）
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL_INTENT=deepseek-chat
# MODEL_PLANNER=deepseek-chat
# MODEL_GENERATOR=deepseek-chat

# ── 资源检索（可选，留空则降级为 mock 数据）───────────────────────────────────
YOUTUBE_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# ── 应用配置 ──────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DEFAULT_LANGUAGE=zh
MAX_NODES=6
RETRIEVAL_TOP_K=5
HTTP_TIMEOUT_SECONDS=10
